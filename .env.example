# Claude / Agent SDK
ANTHROPIC_API_KEY=

# Discovery — official APIs only
YOUTUBE_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_ACCESS_TOKEN=

# Video generation vendors
# Higgsfield is provided via the connected MCP server in Claude environments —
# no key needed here when running inside that environment.
# Kling authenticates with a signed JWT derived from an Access Key / Secret Key pair
# (not a single static API key) — see https://kling.ai/document-api/api/get-started/authentication
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
RUNWAY_API_KEY=
# Pika no longer runs a standalone public API (as of Dec 2025) — it's served through
# fal.ai's platform instead. This is a fal.ai API key, not a Pika-specific one.
FAL_KEY=

# Local scaffold paths
VVUGC_DB_PATH=./runs/review-queue.json
VVUGC_RUNS_DIR=./runs
