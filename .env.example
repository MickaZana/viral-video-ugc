# Claude / Agent SDK
ANTHROPIC_API_KEY=

# Discovery — official APIs only
YOUTUBE_API_KEY=
# TikTok Research API — requires an approved research-access application; see
# README's Platform support section. The adapter exchanges these for a Bearer
# token itself (client-credentials OAuth).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram hashtag discovery — requires an approved Meta app (instagram_basic
# permission). Both vars are required: a token alone is not enough, Instagram's
# hashtag-search endpoints also require the querying Business/Creator Account's ID.
META_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=

# Video generation vendors
# Higgsfield background jobs connect to its remote MCP over Streamable HTTP.
# Set a valid account-authorized MCP OAuth access token; API key ID/secret are
# not MCP credentials. The server URL defaults to https://mcp.higgsfield.ai/mcp.
HIGGSFIELD_MCP_ACCESS_TOKEN=
MCP_SERVER_URL=
# Kling authenticates with a signed JWT derived from an Access Key / Secret Key pair
# (not a single static API key) — see https://kling.ai/document-api/api/get-started/authentication
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
RUNWAY_API_KEY=
# Pika no longer runs a standalone public API (as of Dec 2025) — it's served through
# fal.ai's platform instead. This is a fal.ai API key, not a Pika-specific one.
FAL_KEY=
# Seedance (also via fal.ai) — model-base override; defaults to
# "bytedance/seedance-2.5" if unset. Pin back e.g. "bytedance/seedance-2.0".
# See packages/mcp-video-gen/src/adapters/seedance.ts.
SEEDANCE_MODEL=
# Gemini image generation (--video-vendor gemini) — generates a still image per script
# segment and Ken-Burns-pans it into a clip, instead of calling a video vendor. Also
# used by apps/marketing-site/scripts/generate-demo-videos.ts to populate the landing
# page's placeholder gallery. See packages/mcp-video-gen/src/adapters/gemini.ts.
GEMINI_API_KEY=
# Defaults to "gemini-2.5-flash-image" ("Nano Banana") if unset.
GEMINI_IMAGE_MODEL=
# Replicate (--video-vendor replicate) — a model-hosting platform, not a single vendor:
# one token gives access to many interchangeable text-to-video models (Luma Ray,
# MiniMax/Hailuo, Kling, Wan, Veo, and others) through the same REST API. Get a token
# at https://replicate.com/account/api-tokens. See packages/mcp-video-gen/src/adapters/replicate.ts.
REPLICATE_API_TOKEN=
# Alias for deployments that name the same Replicate credential as an API key.
REPLICATE_API_KEY=
# Model slug to run, e.g. "minimax/video-01" or "luma/ray-3.2" — defaults to
# replicate.ts's own DEFAULT_MODEL if unset.
REPLICATE_MODEL=
# How long to poll a Replicate prediction before giving up (ms). Optional —
# defaults to 8 minutes, clamped to 1–30 minutes.
REPLICATE_POLL_DEADLINE_MS=
# Alibaba Cloud Model Studio hosted video generation (--video-vendor alibaba).
# Create a region-matched API key and use the endpoint for that same region.
# The default model is wan3.0-video. Model IDs can be changed to supported
# Wan 2.7 / HappyHorse 1.1 variants shown in your Model Studio console.
DASHSCOPE_API_KEY=
# Alias accepted for the same Alibaba Wan 3.0 / Model Studio credential.
WAN3.0_API_KEY=
# Full video-synthesis endpoint (including workspace id when required), for example:
# https://<workspace>.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
# Defaults to the legacy Singapore endpoint https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
ALIBABA_VIDEO_ENDPOINT=
ALIBABA_VIDEO_MODEL=wan3.0-video
# Poll every 15 seconds for up to 15 minutes by default.
ALIBABA_VIDEO_POLL_INTERVAL_MS=15000
ALIBABA_VIDEO_MAX_WAIT_MS=900000

# Talking-head lipsync (packages/mcp-lipsync) — fully optional; only needed when a
# lipsync vendor is selected. Each adapter throws a clear "key is required" error
# if chosen without its key. Leave both unset if you don't use lipsync.
SYNC_LABS_API_KEY=
HEYGEN_API_KEY=

# Voiceover narration — perfectly synced to the burned-in captions (each caption cue's
# audio is synthesized separately and time-conformed to that exact cue's timing window,
# so captions and narration can never drift). Fully optional: set --voice-vendor on the
# CLI to enable it (elevenlabs | grok); leave everything below unset to keep videos
# silent/vendor-native-audio, today's default behavior. See packages/mcp-voiceover/README.md.
ELEVENLABS_API_KEY=
# Defaults to a stable built-in ElevenLabs voice ("Rachel") if unset.
ELEVENLABS_VOICE_ID=
# Same XAI_API_KEY as any other xAI/Grok API usage — not voiceover-specific.
XAI_API_KEY=
# Alias for the same xAI credential — shared-config accepts either name.
GROK_API_KEY=
# Defaults to xAI's "eve" voice if unset.
GROK_VOICE_ID=

# ASR fallback transcription — used when a candidate has no platform caption track
# (all of TikTok/Instagram/Facebook, plus YouTube videos with captions disabled).
# Audio is extracted via yt-dlp (bundled, no separate install needed) then sent to
# OpenAI's Whisper API. Requires python3 on the host running the orchestrator (yt-dlp-exec's
# install-time check) — already handled in Dockerfile.orchestrator for the container path.
OPENAI_API_KEY=

# ── LLM model/provider overrides (apps/orchestrator llm-failover.ts + agents) ──
# All optional — every one falls back to the verified default in code when unset.
# Keep docs/cost-table.md in mind: overriding to a model absent from
# packages/shared-cost/src/index.ts's rate tables prices it at $0 in the ledger.
# Model used by the long-form production stage — defaults to "claude-sonnet-5".
ANTHROPIC_LONG_FORM_MODEL=
# Failover-chain model overrides — defaults: GEMINI_MODEL "gemini-3.1-pro-preview"
# (caption-agent: "gemini-3.6-flash"), GROK_MODEL "grok-4.3", OPENAI_MODEL "gpt-4.1-mini",
# KIMI_MODEL "kimi-k3" (Ad Storyboard agent, opt-in provider only).
GEMINI_MODEL=
GROK_MODEL=
OPENAI_MODEL=
KIMI_MODEL=
# Kimi/Moonshot credential — required only when the Ad Storyboard agent's opt-in
# preferredProvider "kimi" is used. Two names for the same Moonshot API key;
# MOONSHOT_API_KEY is Moonshot's own name, KIMI_API_KEY is the alias.
MOONSHOT_API_KEY=
KIMI_API_KEY=

# Publishing (packages/mcp-publish) — never called automatically by the pipeline,
# only from an explicit post-approval action in the review dashboard (POST
# /queue/:id/publish on an item already status=approved). Leave all unset to keep
# publishing entirely unavailable; each is independent per platform.
# TikTok: a user access token (not TIKTOK_CLIENT_KEY/SECRET) from a completed
# 3-legged OAuth flow granting the video.publish scope.
TIKTOK_ACCESS_TOKEN=
# Facebook Page publishing: a Page access token (not a user token, and not
# META_ACCESS_TOKEN, which is discovery's hashtag-search token) with
# pages_manage_posts, plus the App ID that owns the upload session and the
# destination Page's id. Instagram Reels publishing is not implemented — its
# Content Publishing API needs a public video URL this pipeline can't supply.
META_PAGE_ACCESS_TOKEN=
# Also required by Facebook publishing: the resumable Upload API session init
# (POST /<APP_ID>/uploads) authenticates with a user access token even though
# the final publish is a Page post. See packages/mcp-publish/src/tools/meta.ts.
META_USER_ACCESS_TOKEN=
META_APP_ID=
META_PAGE_ID=
# YouTube: an OAuth access token with the youtube.upload scope.
YOUTUBE_ACCESS_TOKEN=

# Preferred YouTube publishing setup — the account UI starts Google's OAuth
# consent flow and stores each client's resulting access/refresh tokens encrypted.
# Create a "Web application" OAuth client and register:
#   local:      http://localhost:4310/oauth/google/callback
#   production: https://YOUR_PUBLIC_DOMAIN/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4310/oauth/google/callback
# Independent random secrets, at least 32 characters each. Never reuse an API key.
OAUTH_STATE_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Dedicated AEAD key (at least 32 characters) for TOTP/MFA secrets stored in
# Postgres — REQUIRED whenever DATABASE_URL is set, and by validateProductionEnv
# in production. Intentionally separate from SOCIAL_TOKEN_ENCRYPTION_KEY so each
# can be rotated independently.
MFA_ENCRYPTION_KEY=
# Dashboard login session lifetime in seconds — optional, defaults to 30 days.
SESSION_TTL_SECONDS=
# Key rotation helpers for SOCIAL_TOKEN_ENCRYPTION_KEY (one-shot):
# apps/review-dashboard/src/rotate-social-key.ts re-encrypts stored tokens from
# OLD to NEW, then you copy NEW's value into SOCIAL_TOKEN_ENCRYPTION_KEY and unset
# both. Required only when actually rotating; the script refuses to run without them.
SOCIAL_TOKEN_ENCRYPTION_KEY_OLD=
SOCIAL_TOKEN_ENCRYPTION_KEY_NEW=

# Billing (packages/shared-billing) — placeholder-tier scaffolding (see tiers.ts;
# the dollar amounts there are NOT real pricing, replace before going live). Leave
# all unset to keep the /accounts/billing UI visible but checkout unusable — it fails
# with a clear "not configured" error rather than silently charging a placeholder price.
STRIPE_SECRET_KEY=
# Signing secret for POST /webhooks/stripe (Stripe CLI: `stripe listen --print-secret`).
STRIPE_WEBHOOK_SECRET=
# Real Stripe Price IDs — one per tier in shared-billing/src/tiers.ts. Each tier's
# checkout stays disabled (clear error, not a fallback price) until its own is set.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_AGENCY=

# Local scaffold paths
VVUGC_DB_PATH=./runs/review-queue.json
VVUGC_RUNS_DIR=./runs

# ── Governance gates (see README "LLM & external-call safety") ──
# Real LLM / vendor execution is a TWO-KEY lock. Even if a client sends
# live:true, runs stay in dry-run (mock) mode unless this is explicitly "true".
# Leave unset (default) for safe, zero-spend operation.
VVUGC_LLM_LIVE=
# External discovery (YouTube/TikTok/Meta platform scraping) is OFF unless this
# is "true". When unset, /accounts/discover returns an empty list and the editor
# seeds a brief from the niche text — fully offline, never a 500.
VVUGC_DISCOVERY_LIVE=
# Scheduled (cron) runs may go live only if BOTH this and VVUGC_LLM_LIVE are "true".
SCHEDULED_RUNS_LIVE=

# ── Platform feature flags (packages/shared-platform; all default OFF) ──
# Set to "true" to un-dormant each feature; leave unset for stock behavior.
# Agency/client UI and routes.
VVUGC_AGENCY_CLIENTS_ENABLED=
# Public /v1 API namespace — unset/false returns 404 for every /v1 route.
VVUGC_API_ENABLED=
# Admin dashboard routes.
VVUGC_PLATFORM_ADMIN_ENABLED=
# Webhook management routes (feature is dormant until enabled).
VVUGC_WEBHOOKS_ENABLED=

# ── Review-dashboard scheduling / background jobs ──
# All optional with in-code defaults: client scheduler every 60s, pipeline job
# worker every 1s. Raise/lower only to tune load on the dashboard host.
CLIENT_SCHEDULER_INTERVAL_MS=
PIPELINE_JOB_INTERVAL_MS=

# ── Video worker (apps/video-worker; see docs/video-worker.md) ──
# All optional — defaults shown. Worker honors the same VVUGC_LLM_LIVE gate.
# Max parallel provider jobs.
VIDEO_WORKER_CONCURRENCY=2
# Empty-queue poll interval (ms) and job lease duration (ms).
VIDEO_WORKER_POLL_MS=5000
VIDEO_WORKER_LEASE_MS=120000
# HTTP port for /healthz, /metrics, /status.
VIDEO_WORKER_HEALTH_PORT=4330
# MCP session connection timeout (ms) and max reconnect attempts.
MCP_CONNECT_TIMEOUT_MS=30000
MCP_MAX_RECONNECT_ATTEMPTS=5
# Cap x264 encoder threads during assembly (mcp-assembly) — for constrained hosts
# (small containers, CI runners). Unset: ffmpeg picks its own default.
VVUGC_FFMPEG_THREADS=

# ── Long-form / remix one-shot scripts ──
# apps/orchestrator/remix-live.ts — source video URL to remix and the niche to
# rewrite it for (default niche: "personal finance"). Only read by that script.
REMIX_SOURCE_URL=
REMIX_NICHE=

# ── Backups (scripts/backup-runs.ts) ──
# Archive destination (default ./backups), retention in days (default 7), and
# "true" to skip .mp4 files for smaller archives. Only read by that script.
BACKUP_DIR=
BACKUP_RETAIN_DAYS=7
BACKUP_EXCLUDE_VIDEOS=

# Review-queue persistence — leave DATABASE_URL unset for local/single-machine use
# (JSON file above). Set it when the dashboard and orchestrator run on separate
# machines/processes (e.g. dashboard as a hosted service, orchestrator as a
# GitHub Actions job) — a Postgres connection string, e.g. from a free tier at
# neon.tech / supabase.com / railway.app. See packages/review-queue/README.md.
DATABASE_URL=
# Supabase users may set SUPABASE_DATABASE_URL instead; DATABASE_URL wins if both are present.
SUPABASE_DATABASE_URL=
# Retention (days) for the dashboard's audit.ndjson + security-events.ndjson log
# streams — optional, defaults to 90.
SECURITY_LOG_RETENTION_DAYS=

# Marketing-site email capture — forwards each submission to this webhook
# (Zapier/Make, a Google Apps Script Web App backed by a Sheet, etc). Leave
# unset to only persist submissions locally to runs/waitlist.jsonl.
WAITLIST_WEBHOOK_URL=

# Review-dashboard login (HTTP Basic Auth) — it approves/rejects content before
# it ships, so it is never served unauthenticated. Leave both unset for local
# dev/testing and the dashboard will generate a random one-time password and
# print it to the startup log; set both here for a stable login that survives
# restarts (required for any real deployment — set these as real secrets, not
# in a committed .env).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Number of reverse-proxy hops in front of review-dashboard/marketing-site (Express's
# "trust proxy" setting). Leave unset for local dev or a directly exposed container —
# defaults to 0 (trust nothing). Set to 1 if deployed behind exactly one reverse proxy/
# load balancer (Fly.io, Railway, nginx, an ALB) — otherwise the rate limiters (keyed by
# client IP) will bucket every real client together under the proxy's own IP.
TRUST_PROXY_HOPS=

# HTTP bind for the Node servers — optional. PORT defaults to 4310 (review-dashboard)
# or 4320 (marketing-site); HOST defaults to 0.0.0.0.
PORT=
HOST=
# control-panel's Vite dev server proxies /api here — optional, defaults to
# http://localhost:4310. Dev tooling only; never needed in production.
API_PROXY_TARGET=

# Marketing-site public origin — og:image/twitter:image must be absolute URLs
# per spec, and the server can't otherwise know its own public origin (e.g.
# behind a proxy/CDN with a different host than what it binds to). Leave unset
# for local dev (falls back to deriving it from each incoming request); set it
# explicitly to your real deployed domain (no trailing slash) in production.
#
# Also required for Instagram Reels publishing: the review-dashboard uses this
# same origin to hand Meta's Content Publishing API a signed, time-limited
# video_url it can fetch (see apps/review-dashboard/src/public-assets.ts) —
# without it set to a real publicly reachable address, Reels publishing fails
# fast with a clear error instead of a network hang.
PUBLIC_BASE_URL=

# HMAC secret for signing those short-lived public video URLs. Optional: an
# in-memory secret is generated at startup if unset, which is fine for a
# single long-running dashboard process but won't survive a restart mid-token.
ASSET_SIGNING_SECRET=

# Marketing-site legal identity for /privacy and /terms — REQUIRED in production
# (the server refuses to boot without ENTITY_NAME + PRIVACY_EMAIL so real legal
# pages never render placeholder text). ADDRESS is optional. See docs/surfaces.md.
LEGAL_ENTITY_NAME=
LEGAL_PRIVACY_EMAIL=
LEGAL_ADDRESS=

# Marketing-site's link to the real product — the origin apps/review-dashboard
# serves apps/control-panel's SPA from (at "/app"), a fully separate deployment
# from marketing-site itself. Powers the marketing page's header "Sign In" and
# CTA-section "Try it now" links (${APP_BASE_URL}/app?mode=signin|signup) so a
# visitor can reach the actual product, not just the waitlist. Leave unset for
# local dev (falls back to http://localhost:4310, review-dashboard's own dev
# port); set it explicitly to your real deployed review-dashboard origin (no
# trailing slash) in production.
APP_BASE_URL=
