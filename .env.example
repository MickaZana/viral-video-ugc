# Claude / Agent SDK
ANTHROPIC_API_KEY=

# Discovery — official APIs only
YOUTUBE_API_KEY=
# TikTok Research API — requires an approved research-access application; see
# README's Platform support section. The adapter exchanges these for a Bearer
# token itself (client-credentials OAuth).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram hashtag discovery — requires an approved Meta app (instagram_basic
# permission). Both vars are required: a token alone is not enough, Instagram's
# hashtag-search endpoints also require the querying Business/Creator Account's ID.
META_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=

# Video generation vendors
# Higgsfield is provided via the connected MCP server in Claude environments —
# no key needed here when running inside that environment.
# Kling authenticates with a signed JWT derived from an Access Key / Secret Key pair
# (not a single static API key) — see https://kling.ai/document-api/api/get-started/authentication
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
RUNWAY_API_KEY=
# Pika no longer runs a standalone public API (as of Dec 2025) — it's served through
# fal.ai's platform instead. This is a fal.ai API key, not a Pika-specific one.
FAL_KEY=
# Gemini image generation (--video-vendor gemini) — generates a still image per script
# segment and Ken-Burns-pans it into a clip, instead of calling a video vendor. Also
# used by apps/marketing-site/scripts/generate-demo-videos.ts to populate the landing
# page's placeholder gallery. See packages/mcp-video-gen/src/adapters/gemini.ts.
GEMINI_API_KEY=
# Defaults to "gemini-2.5-flash-image" ("Nano Banana") if unset.
GEMINI_IMAGE_MODEL=

# Voiceover narration — perfectly synced to the burned-in captions (each caption cue's
# audio is synthesized separately and time-conformed to that exact cue's timing window,
# so captions and narration can never drift). Fully optional: set --voice-vendor on the
# CLI to enable it (elevenlabs | grok); leave everything below unset to keep videos
# silent/vendor-native-audio, today's default behavior. See packages/mcp-voiceover/README.md.
ELEVENLABS_API_KEY=
# Defaults to a stable built-in ElevenLabs voice ("Rachel") if unset.
ELEVENLABS_VOICE_ID=
# Same XAI_API_KEY as any other xAI/Grok API usage — not voiceover-specific.
XAI_API_KEY=
# Defaults to xAI's "eve" voice if unset.
GROK_VOICE_ID=

# Local scaffold paths
VVUGC_DB_PATH=./runs/review-queue.json
VVUGC_RUNS_DIR=./runs

# Review-queue persistence — leave DATABASE_URL unset for local/single-machine use
# (JSON file above). Set it when the dashboard and orchestrator run on separate
# machines/processes (e.g. dashboard as a hosted service, orchestrator as a
# GitHub Actions job) — a Postgres connection string, e.g. from a free tier at
# neon.tech / supabase.com / railway.app. See packages/review-queue/README.md.
DATABASE_URL=

# Marketing-site email capture — forwards each submission to this webhook
# (Zapier/Make, a Google Apps Script Web App backed by a Sheet, etc). Leave
# unset to only persist submissions locally to runs/waitlist.jsonl.
WAITLIST_WEBHOOK_URL=

# Review-dashboard login (HTTP Basic Auth) — it approves/rejects content before
# it ships, so it is never served unauthenticated. Leave both unset for local
# dev/testing and the dashboard will generate a random one-time password and
# print it to the startup log; set both here for a stable login that survives
# restarts (required for any real deployment — set these as real secrets, not
# in a committed .env).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Number of reverse-proxy hops in front of review-dashboard/marketing-site (Express's
# "trust proxy" setting). Leave unset for local dev or a directly exposed container —
# defaults to 0 (trust nothing). Set to 1 if deployed behind exactly one reverse proxy/
# load balancer (Fly.io, Railway, nginx, an ALB) — otherwise the rate limiters (keyed by
# client IP) will bucket every real client together under the proxy's own IP.
TRUST_PROXY_HOPS=

# Marketing-site public origin — og:image/twitter:image must be absolute URLs
# per spec, and the server can't otherwise know its own public origin (e.g.
# behind a proxy/CDN with a different host than what it binds to). Leave unset
# for local dev (falls back to deriving it from each incoming request); set it
# explicitly to your real deployed domain (no trailing slash) in production.
PUBLIC_BASE_URL=
