{
  "name": "viral-video-ugc",
  "private": true,
  "version": "0.1.0",
  "description": "Claude-powered, cloud-orchestrated viral video discovery/repurposing pipeline",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "cli": "pnpm --filter @vvugc/orchestrator cli",
    "feedback": "pnpm --filter @vvugc/orchestrator exec tsx ../../scripts/collect-feedback.ts",
    "backup": "pnpm --filter @vvugc/orchestrator exec tsx ../../scripts/backup-runs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^26.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^15",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  }
}
