+/**
+ * Resolves the calling user's orgId for tenant scoping on the operator routes.
+ * - Session-authenticated users (control-panel SPA): returns their org's ID — they
+ *   can only see/act on their own organization's data.
+ * - Operator-authenticated users (Basic Auth): returns undefined — the operator
+ *   intentionally has cross-org visibility (they're the platform admin).
+ *
+ * This is the SINGLE point of truth for tenant scoping on every route below the
+ * dual-auth gate. If this returns a string, every data query MUST filter by it.
+ */
+function resolveRequestOrg(req: Request & { accountId?: string }): string | undefined {
+  if (!req.accountId) return undefined; // Basic Auth operator — sees all
+  const account = operatorAccountStore.findById(req.accountId);
+  if (!account) return undefined; // Deleted account edge case — fail open to 401 elsewhere
+  return resolveOrgId(account);
+}
