# Builds and runs the review-dashboard (approve/reject queue UI) as a long-running HTTP server.
FROM node:20-slim AS build
WORKDIR /repo

# python3 is required at `pnpm install` time, not just runtime — this image now
# transitively depends on @vvugc/orchestrator (regenerateScene/regenerateScript),
# which depends on @vvugc/mcp-transcript, whose yt-dlp-exec dependency runs a
# `preinstall` hook that version-checks a system `python` binary (a vestige of
# the youtube-dl fork it's based on; the actual yt-dlp binary it downloads needs
# no Python at runtime). Without this, `pnpm install --frozen-lockfile` below
# fails outright — see Dockerfile.orchestrator's identical comment.
RUN apt-get update && apt-get install -y --no-install-recommends python3 python-is-python3 && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/review-dashboard/package.json apps/review-dashboard/package.json
COPY apps/orchestrator/package.json apps/orchestrator/package.json
COPY apps/marketing-site/package.json apps/marketing-site/package.json
COPY apps/control-panel/package.json apps/control-panel/package.json
COPY packages/shared-schema/package.json packages/shared-schema/package.json
COPY packages/shared-config/package.json packages/shared-config/package.json
COPY packages/shared-cost/package.json packages/shared-cost/package.json
COPY packages/mcp-discovery/package.json packages/mcp-discovery/package.json
COPY packages/mcp-transcript/package.json packages/mcp-transcript/package.json
COPY packages/mcp-video-gen/package.json packages/mcp-video-gen/package.json
COPY packages/mcp-assembly/package.json packages/mcp-assembly/package.json
COPY packages/review-queue/package.json packages/review-queue/package.json
COPY packages/design-tokens/package.json packages/design-tokens/package.json
COPY packages/shared-http/package.json packages/shared-http/package.json
COPY packages/shared-metrics/package.json packages/shared-metrics/package.json
COPY packages/mcp-voiceover/package.json packages/mcp-voiceover/package.json
COPY packages/shared-auth/package.json packages/shared-auth/package.json
COPY packages/shared-originality/package.json packages/shared-originality/package.json
COPY packages/mcp-publish/package.json packages/mcp-publish/package.json
COPY packages/shared-billing/package.json packages/shared-billing/package.json

RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY apps apps
COPY packages packages

RUN pnpm -r run build

FROM node:20-slim AS runtime
WORKDIR /repo
ENV NODE_ENV=production

# Same reason as the build stage above — the runtime stage below does its own
# fresh `pnpm install --prod`, which re-triggers yt-dlp-exec's preinstall check.
RUN apt-get update && apt-get install -y --no-install-recommends python3 python-is-python3 && rm -rf /var/lib/apt/lists/*

# shared-config's REPO_ROOT falls back to process.cwd() when INIT_CWD is unset — pnpm sets
# INIT_CWD when it launches a script, but this container's CMD runs `node dist/server.js`
# directly, so without this, VVUGC_RUNS_DIR/VVUGC_DB_PATH would default relative to this
# app's own WORKDIR (/repo/apps/review-dashboard) instead of the repo root the `./runs`
# bind mount in docker-compose.yml targets (/repo/runs) — silently writing into the
# container's ephemeral layer instead of the shared, persisted volume.
ENV INIT_CWD=/repo

RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

COPY --from=build /repo ./
# The build stage's `pnpm install` pulls in devDependencies too (needed for `tsc -b`,
# vitest, etc.) — without this, those end up shipped in the runtime image, including
# whatever CVEs happen to be open in build/test tooling that never actually runs here
# (found via `pnpm-lock.yaml` scanning: a Critical-severity vitest CVE was sitting in
# every runtime image before this line existed). `pnpm prune --prod` looks like the
# obvious fix but triggers an interactive "reinstall from scratch?" prompt in this pnpm
# version that silently no-ops with no TTY/stdin in a Docker RUN layer — verified by
# hand, not assumed. Wiping node_modules and reinstalling --prod is slower but actually
# deterministic; dist/ output from the build stage is untouched (it's outside node_modules).
RUN find . -maxdepth 3 -type d -name node_modules -prune -exec rm -rf {} + \
    && pnpm install --prod --frozen-lockfile

# ─── SOURCE CODE PROTECTION ──────────────────────────────────────────────────
# The build stage compiled TypeScript → JavaScript (dist/). The runtime image
# only needs dist/ and package.json to run. Strip everything a reverse engineer
# could use: original TypeScript source, test files, declaration files (only
# needed by downstream TypeScript compilation, not at runtime), and markdown.
RUN find . -name '*.ts' ! -name '*.d.ts' -path '*/src/*' -delete 2>/dev/null; \
    find . -name '*.tsx' -path '*/src/*' -delete 2>/dev/null; \
    find . -name '*.test.*' -delete 2>/dev/null; \
    find . -name '*.spec.*' -delete 2>/dev/null; \
    find . -name '*.d.ts' -delete 2>/dev/null; \
    find . -name '*.map' -delete 2>/dev/null; \
    find . -name '*.md' ! -name 'LICENSE*' -delete 2>/dev/null; true

# Runs as the non-root "node" user the base image already ships (uid/gid 1000),
# not root — limits blast radius if a dependency vulnerability leads to code
# execution inside the container. If you bind-mount ./runs from the host (see
# docker-compose.yml), make sure that directory is writable by uid 1000 (e.g.
# `chmod -R a+rwX runs` once on the host, or override `user:` in compose to
# match your own uid/gid instead).
RUN chown -R node:node /repo
USER node

WORKDIR /repo/apps/review-dashboard
EXPOSE 4310
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:4310/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "dist/server.js"]
